{
  "manifest_version": 3,
  "name": "Mis Notas LinkedIn",
  "version": "1.0",
  "description": "Anota contactos de LinkedIn y exporta a CSV o JSON",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup.html"
  }
}